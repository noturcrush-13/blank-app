# Salin file ini jadi ".streamlit/secrets.toml" (hapus ".example"), lalu isi
# nilainya dari file JSON key service account yang Anda download dari Google
# Cloud Console. JANGAN commit file "secrets.toml" ke git (sudah di-.gitignore-kan).
#
# Untuk deploy di Streamlit Community Cloud: isi yang sama ini ditempel di
# menu app Anda -> Settings -> Secrets (bukan lewat file).

# Link & tab Google Sheet — WAJIB diisi supaya app tahu sheet mana yang
# dibuka (terutama saat di-deploy, karena config lokal tidak ikut ter-deploy).
sheet_url = "https://docs.google.com/spreadsheets/d/ISI_ID_SHEET_ANDA/edit"
sheet_tab = "Form Responses 1"

# ClickUp — dipakai tab "Highlight Issue" & "SPI".
# api_token: ClickUp -> Settings -> Apps -> "Generate" (personal token, diawali "pk_").
# list_id  : list "Monitoring Issue Operational" (space "Monitoring All System").
[clickup]
api_token = "pk_ISI_TOKEN_ANDA"
list_id = "901820651612"

[gcp_service_account]
type = "service_account"
project_id = "isi-project-id-anda"
private_key_id = "isi-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nISI...\n-----END PRIVATE KEY-----\n"
client_email = "nama-service-account@project-id-anda.iam.gserviceaccount.com"
client_id = "isi-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "isi-dari-json-key-anda"
universe_domain = "googleapis.com"
